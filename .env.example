# ============================================================
#  Memecoin Sniper Bot — пример конфигурации
#  Скопируйте в .env и заполните.  .env НИКОГДА не коммитится.
# ============================================================

# --- Telegram ---------------------------------------------------------------
# Токен от @BotFather
BOT_TOKEN=123456:AAA-your-telegram-bot-token
# Telegram ID администраторов через запятую (узнать у @userinfobot)
ADMIN_IDS=123456789
# Если задан — ботом смогут пользоваться только эти ID (белый список).
# Пусто = доступ открыт всем.
ALLOWED_USER_IDS=

# --- Шифрование приватных ключей --------------------------------------------
# ОБЯЗАТЕЛЬНО. Длинная случайная строка. Потеря = потеря доступа ко всем кошелькам.
# Сгенерировать:  python -c "import secrets;print(secrets.token_urlsafe(48))"
MASTER_KEY=CHANGE_ME_super_long_random_secret

# --- Хранилище ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/sniper.db
LOG_LEVEL=INFO

# --- Сети --------------------------------------------------------------------
# Список активных сетей через запятую (ключи из config/chains.json)
ENABLED_CHAINS=bsc
DEFAULT_CHAIN=bsc

# BNB Smart Chain: свой приватный RPC заметно ускоряет снайп
BSC_RPC_URLS=
# Uniswap V3 в BSC (необязательно): адреса из документации DEX.
# Нужны все три, иначе площадка не включится.
BSC_V3_ROUTER=
BSC_V3_FACTORY=
BSC_V3_QUOTER=
# BSC_V3_FEES=100,500,3000,10000     # тиры комиссий, если у форка свои
# BSC_DEFAULT_DEX=v3                 # какую площадку считать основной: v2 или v3
# Robinhood Chain — заполнить, когда сеть/DEX доступны
RH_ENABLED=false
RH_CHAIN_ID=
RH_RPC_URLS=
RH_ROUTER=
RH_FACTORY=
RH_WRAPPED_NATIVE=
RH_EXPLORER_URL=
RH_NATIVE_SYMBOL=ETH
# Uniswap V3 на Robinhood Chain: роутер, фабрика и QuoterV2
RH_V3_ROUTER=
RH_V3_FACTORY=
RH_V3_QUOTER=
# RH_V3_FEES=100,500,3000,10000
# RH_V3_VARIANT=router02             # router01, если у DEX старый SwapRouter с deadline
# RH_DEFAULT_DEX=v3

# --- Движок снайпера ---------------------------------------------------------
# Период опроса новых пар, сек. Меньше = быстрее реакция, но больше запросов к RPC
SCANNER_POLL_INTERVAL=2.0
# Сколько блоков ждать ликвидность сразу после создания пары
SCANNER_LIQUIDITY_WAIT_BLOCKS=40
# Сколько минут возвращаться к паре, если ликвидность залили позже
SCANNER_LIQUIDITY_WATCH_MINUTES=180
# Как часто перепроверять такие пары, сек
SCANNER_WATCH_INTERVAL=12.0
# Период проверки открытых позиций (TP/SL/трейлинг), сек
POSITION_POLL_INTERVAL=6.0
# Свежие позиции проверяются чаще: главные потери случаются в первые минуты
FAST_POLL_INTERVAL=1.5
FAST_WATCH_MINUTES=15
# Период проверки пополнений кошельков, сек
DEPOSIT_POLL_INTERVAL=30.0

# --- Перехват разгона --------------------------------------------------------
# Окно наблюдения: раз в столько секунд бот снимает замер по всем пулам списка.
# Короче окно — раньше вход, но больше шума от единичных сделок.
MOMENTUM_INTERVAL=45.0
# Сколько пулов держать под наблюдением одновременно
MOMENTUM_WATCH_LIMIT=300
# Сколько часов хранить замеры цен (нужны только для сравнения соседних окон)
MOMENTUM_SAMPLE_TTL_HOURS=24
# Как часто можно повторно разбирать один и тот же пул, мин
MOMENTUM_RETRY_MINUTES=30
# Разовый разбор истории фабрик при старте: сколько блоков назад искать пулы,
# которые появились до запуска бота. 0 — не разбирать
MOMENTUM_BACKFILL_BLOCKS=20000

# --- Комиссия сервиса (необязательно) ---------------------------------------
# Комиссия в базисных пунктах от суммы покупки (100 = 1%). 0 = выключено.
SERVICE_FEE_BPS=0
SERVICE_FEE_WALLET=
